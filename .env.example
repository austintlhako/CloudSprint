# CloudSprint Environment Variables Template
# Copy this file to .env and fill in your actual Supabase credentials
# NEVER add service_role key or database passwords to this file

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Supabase Configuration for CloudSprint (Dev B)
# Obtain these from your Supabase Project Settings -> API
# NOTE: Only use the publishable anon key here. NEVER expose the service_role key!

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here
